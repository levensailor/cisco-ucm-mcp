UCM_HOST=10.10.20.1
UCM_USERNAME=axlaccess
UCM_PASSWORD=changeme
UCM_VERSION=15.0
UCM_PORT=8443
UCM_VERIFY_SSL=false

# Write gates (all default false)
UCM_ALLOW_WRITES=false
UCM_ALLOW_SERVICE_CONTROL=false
UCM_ALLOW_PHONE_EXECUTE=false

# Phone CGI Execute / optional phone web auth
PHONE_USERNAME=
PHONE_PASSWORD=

# Transport: stdio (default) or http
UCM_TRANSPORT=stdio
UCM_HTTP_HOST=127.0.0.1
UCM_HTTP_PORT=8000

# Logging
UCM_LOG_DIR=logs
UCM_LOG_LEVEL=INFO
